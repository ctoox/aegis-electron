# ---- 国内镜像加速（Electron 打包必需）----------------------------------
# 说明：npm 会把这里的每一项转成 npm_config_<key> 环境变量传给 npm scripts，
#       @electron/get 与 electron-builder 都会读取，从而自动走国内源。
# 若某天镜像不可用，删掉本文件即可回退官方源。

# 1) Electron 二进制镜像（electron 包 postinstall 下载 100+MB 时用）
electron_mirror=https://npmmirror.com/mirrors/electron/

# 2) electron-builder 自身资源镜像（nsis / nsis-resources / winCodeSign / 7zip 等）
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# 3) npm 包镜像（安装/更新依赖用）
registry=https://registry.npmmirror.com/
