{
  "name": "aegis-electron",
  "version": "0.1.0",
  "description": "神盾 Aegis — 本地优先、零知识加密的开源密码管理器（桌面版）",
  "license": "MIT",
  "author": "神盾 Aegis 项目贡献者 (Aegis Project Contributors)",
  "private": true,
  "homepage": "https://github.com/OWNER/aegis-electron#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/aegis-electron.git"
  },
  "bugs": {
    "url": "https://github.com/OWNER/aegis-electron/issues"
  },
  "keywords": [
    "password-manager",
    "password-vault",
    "argon2id",
    "aes-256-gcm",
    "totp",
    "zero-knowledge",
    "encryption",
    "electron",
    "offline",
    "local-first"
  ],
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/vault.test.ts && tsx tests/vault-ops.test.ts && tsx tests/share.test.ts && tsx tests/totp.test.ts && tsx tests/health.test.ts && tsx tests/hibp.test.ts && tsx tests/portable.test.ts && tsx tests/settings.test.ts && tsx tests/autotype.test.ts && tsx tests/gpu.test.ts && tsx tests/refresh.test.ts",
    "check:purity": "tsx scripts/check-renderer-purity.ts",
    "check:assets": "tsx scripts/check-package-assets.ts",
    "check:share-interop": "echo \"跨实现互通测试：需要另一实现（Python 版）的环境，该实现不在本仓库内。用法见 scripts/interop-share.py 文件头。\"",
    "smoke": "node scripts/smoke-electron.mjs",
    "shot:ui": "node scripts/shot-ui.mjs",
    "bench:render": "node scripts/bench-render.mjs",
    "bench:switch": "node scripts/bench-switch.mjs",
    "trace:mount": "node scripts/trace-mount.mjs",
    "capture:switch": "node scripts/capture-switch.mjs",
    "seed:visual": "tsx scripts/seed-visual-demo.ts",
    "list:asar": "node scripts/list-asar.mjs",
    "build:native": "node scripts/build-native.mjs",
    "ci": "npm run typecheck && npm run check:purity && npm run check:assets && npm test",
    "dist:win": "npm run build:native && electron-vite build && electron-builder --win",
    "dist:win:optional": "node scripts/build-native.mjs --optional && electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:all": "npm run build:native && electron-vite build && electron-builder --win --mac --linux"
  },
  "build": {
    "appId": "com.aegis.aegisnext",
    "productName": "AegisNext",
    "files": [
      "out/**/*",
      "package.json",
      "build/icon.png"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "synopsis": "神盾 Aegis 密码管理器",
      "description": "本地优先、零知识加密的开源密码管理器。密码只存在本机，无账号、无云端、无遥测。",
      "maintainer": "神盾 Aegis <aegis@users.noreply.github.com>",
      "desktop": {
        "entry": {
          "Name": "神盾 Aegis",
          "GenericName": "密码管理器",
          "Comment": "本地优先的密码管理器",
          "Categories": "Utility;Security;",
          "StartupWMClass": "AegisNext"
        }
      }
    },
    "deb": {
      "priority": "optional",
      "packageCategory": "utils"
    },
    "rpm": {
      "packageCategory": "Applications/System",
      "compression": "xz"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "${env.GH_OWNER}",
        "repo": "${env.GH_REPO}",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "hash-wasm": "^4.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "vite": "^5.4.11"
  }
}
